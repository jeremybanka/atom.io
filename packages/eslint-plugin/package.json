{
	"name": "@atom.io/eslint-plugin",
	"version": "0.1.1",
	"description": "ESLint rules for atom.io state and transaction declarations.",
	"homepage": "https://atom.io.fyi/docs/eslint-plugin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/eslint-plugin"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc",
		"test": "vitest",
		"test:once": "vitest run",
		"test:once:public": "vitest run --config vitest.public.config.ts",
		"test:breakage": "breakage breakage.config.ts --verbose --baseline-file .breakage/baseline.json",
		"test:breakage:prelude": "breakage prelude breakage.config.ts --out .breakage/baseline.json",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check",
		"cov:recoverage": "recoverage",
		"cov": "vitest run --config vitest.total-coverage.config.ts --coverage",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx"
	},
	"dependencies": {
		"@typescript-eslint/utils": "8.72.1"
	},
	"devDependencies": {
		"@breakage/changesets": "0.1.0",
		"@types/estree": "1.0.10",
		"@types/node": "26.6.6",
		"@typescript-eslint/parser": "8.72.1",
		"@typescript-eslint/rule-tester": "8.72.1",
		"@vitest/coverage-v8": "5.0.5",
		"breakage": "0.10.1",
		"eslint": "10.14.0",
		"recoverage": "0.1.20",
		"tsdown": "0.23.4",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.0.0 || ^10.0.0",
		"typescript": ">=4.8.4 <6.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
