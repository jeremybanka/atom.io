{
	"ui": "tui",
	"globalDependencies": [
		"tsconfig.json",
		".node-version",
		"mise.toml"
	],
	"tasks": {
		"pack:breakage": {
			"dependsOn": ["build"],
			"cache": false,
			"outputs": [".breakage/package.tgz"]
		},
		"test:breakage:peers": {
			"dependsOn": ["pack:breakage", "^pack:breakage"],
			"cache": false,
			"outputs": []
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "docs/agent/**", "agent-docs/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**"
			]
		},
		"readme:write": {
			"dependsOn": ["build", "^build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**",
				"$TURBO_ROOT$/packages/atom.io/docs/source/exhibits/**",
				"$TURBO_ROOT$/packages/create-atom.io/src/create-atom-options.ts"
			],
			"cache": false
		},
		"readme:check": {
			"dependsOn": ["build", "^build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**",
				"$TURBO_ROOT$/packages/atom.io/docs/source/exhibits/**",
				"$TURBO_ROOT$/packages/create-atom.io/src/create-atom-options.ts"
			]
		},
		"manifest:test": {
			"dependsOn": [],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$"
			]
		},
		"test:once": {
			"dependsOn": ["build", "^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**"
			]
		},
		"test:stress:realtime-ipc": {
			"dependsOn": ["build", "@atom.io/react#build"],
			"cache": false,
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**"
			]
		},
		"cov": {
			"dependsOn": ["build", "^build"],
			"outputs": ["coverage/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**"
			]
		},
		"cov:recoverage": {
			"dependsOn": ["cov"],
			"cache": false,
			"passThroughEnv": ["RECOVERAGE_CLOUD_TOKEN", "RECOVERAGE_CLOUD_URL"]
		},
		"cov:public": {
			"dependsOn": ["build", "^build"],
			"outputs": ["coverage-public/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**"
			]
		},
		"test:breakage:prelude": {
			"cache": false
		},
		"test:breakage": {
			"dependsOn": [
				"test:breakage:prelude",
				"^build",
				"build",
				"@atom.io/react#build"
			],
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**",
				"$TURBO_ROOT$/packages/*/package.json",
				"$TURBO_ROOT$/apps/*/package.json",
				"$TURBO_ROOT$/templates/*/package.json",
				"$TURBO_ROOT$/.changeset/**",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/pnpm-lock.yaml",
				"$TURBO_ROOT$/pnpm-workspace.yaml",
				"$TURBO_ROOT$/.github/workflows/test.yml",
				"$TURBO_ROOT$/.github/actions/setup/action.yml",
				{
					"mode": "jit",
					"globs": [
						".breakage/baseline.json"
					]
				},
				"$TURBO_ROOT$/.github/workflows/breakage.yml"
			],
			"outputs": []
		},
		"lint:eslint": {
			"dependsOn": ["^build", "@atom.io/eslint-plugin#build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**",
				"$TURBO_ROOT$/eslint.config.ts"
			]
		},
		"lint:oxlint": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**",
				"$TURBO_ROOT$/oxlint.config.ts",
				"$TURBO_ROOT$/packages/atom.io/oxlint.json"
			]
		},
		"lint:types": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/scripts/**"
			]
		},
		"lint": {
			"dependsOn": ["lint:eslint", "lint:oxlint", "lint:types"]
		},
		"test:packaging": {
			"dependsOn": ["build", "^build"],
			"cache": false
		}
	}
}
