{
	"name": "@atom.io/spa",
	"version": "0.0.9",
	"description": "An atom.io-driven JSX renderer.",
	"homepage": "https://atom.io.fyi/docs/spa",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/spa"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./dist/development/index.js",
			"import": "./dist/index.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"development": "./dist/development/jsx-runtime.js",
			"import": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"development": "./dist/development/jsx-runtime.js",
			"import": "./dist/jsx-runtime.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"development": "./dist/development/server.js",
			"import": "./dist/server.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"development": "./dist/development/vite.js",
			"import": "./dist/vite.js"
		},
		"./hot": {
			"types": "./dist/hot.d.ts",
			"development": "./dist/development/hot.js",
			"import": "./dist/hot.js"
		},
		"./astro": {
			"types": "./dist/astro.d.ts",
			"development": "./dist/development/astro.js",
			"import": "./dist/astro.js"
		},
		"./astro-client": {
			"types": "./dist/astro-client.d.ts",
			"development": "./dist/development/astro-client.js",
			"import": "./dist/astro-client.js"
		},
		"./astro-server": {
			"types": "./dist/astro-server.d.ts",
			"development": "./dist/development/astro-server.js",
			"import": "./dist/astro-server.js"
		},
		"./package.json": "./package.json",
		"./astro-middleware": {
			"types": "./dist/astro-middleware.d.ts",
			"development": "./dist/development/astro-middleware.js",
			"import": "./dist/astro-middleware.js"
		},
		"./astro-application": {
			"types": "./dist/astro-application.d.ts",
			"development": "./dist/development/astro-application.js",
			"import": "./dist/astro-application.js"
		},
		"./renderer": {
			"types": "./dist/renderer.d.ts",
			"development": "./dist/development/renderer.js",
			"import": "./dist/renderer.js"
		},
		"./konva": {
			"types": "./dist/konva.d.ts",
			"development": "./dist/development/konva.js",
			"import": "./dist/konva.js"
		},
		"./three": {
			"types": "./dist/three.d.ts",
			"development": "./dist/development/three.js",
			"import": "./dist/three.js"
		},
		"./motion": {
			"types": "./dist/motion.d.ts",
			"development": "./dist/development/motion.js",
			"import": "./dist/motion.js"
		},
		"./floating": {
			"types": "./dist/floating.d.ts",
			"development": "./dist/development/floating.js",
			"import": "./dist/floating.js"
		},
		"./astro-resumability-client": {
			"types": "./dist/astro-resumability-client.d.ts",
			"development": "./dist/development/astro-resumability-client.js",
			"import": "./dist/astro-resumability-client.js"
		},
		"./astro-resumability-server": {
			"types": "./dist/astro-resumability-server.d.ts",
			"development": "./dist/development/astro-resumability-server.js",
			"import": "./dist/astro-resumability-server.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown && node scripts/size.ts",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc -p tsconfig.json && tsc -p __tests__/fixtures/consumer/tsconfig.json",
		"size": "node scripts/size.ts",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check",
		"test": "vitest",
		"test:once": "vitest run --config vitest.config.ts && pnpm test:consumer && pnpm test:optional-peers",
		"test:consumer": "node __tests__/fixtures/consumer/check.ts",
		"test:production": "node scripts/production-test.ts",
		"test:browser": "astro build --root __tests__/astro && node scripts/browser-test.mjs && node scripts/dev-browser-test.mjs && node scripts/graphics-browser-test.mjs && node scripts/layout-browser-test.mjs && pnpm test:browser:hmr && pnpm test:browser:resumption",
		"test:browser:dev": "node scripts/dev-browser-test.mjs",
		"cov": "vitest run --config vitest.config.ts --coverage",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx",
		"tonnage": "pnpm readme:write",
		"tonnage:check": "pnpm readme:check",
		"test:browser:graphics": "node scripts/graphics-browser-test.mjs && node scripts/layout-browser-test.mjs",
		"test:optional-peers": "node scripts/optional-peers-check.mjs && node __tests__/fixtures/graphics-consumer/check.ts",
		"bench:compiler": "node scripts/compiler-benchmark.ts",
		"example:motion": "vite --config examples/motion/vite.config.ts",
		"test:browser:motion": "node scripts/motion-browser-test.mjs",
		"example:floating": "vite --config examples/floating/vite.config.ts",
		"test:browser:floating": "node scripts/floating-browser-test.mjs",
		"test:browser:resumption": "astro build --root __tests__/resumption && node scripts/resumption-browser-test.mjs && node scripts/resumption-browser-test.mjs --dev",
		"test:browser:layout": "node scripts/layout-browser-test.mjs",
		"test:browser:hmr": "node scripts/hmr-browser-test.mjs && node scripts/hmr-astro-browser-test.mjs"
	},
	"dependencies": {
		"@jridgewell/remapping": "2.3.5",
		"html-entities": "2.6.0",
		"magic-string": "1.4.5",
		"oxc-parser": "0.158.0"
	},
	"devDependencies": {
		"@breakage/changesets": "0.1.0",
		"@floating-ui/dom": "1.8.0",
		"@jridgewell/trace-mapping": "0.3.31",
		"@types/node": "26.6.6",
		"@types/three": "0.187.0",
		"@vitest/coverage-v8": "5.1.0",
		"astro": "7.4.11",
		"atom.io": "workspace:*",
		"breakage": "0.10.2",
		"esbuild": "0.28.2",
		"eslint": "10.14.0",
		"happy-dom": "21.0.4",
		"konva": "10.9.1",
		"motion": "14.14.0",
		"playwright": "1.65.0",
		"preact": "11.2.0",
		"resumability": "workspace:*",
		"rolldown": "1.3.2",
		"three": "0.187.0",
		"tsdown": "0.23.7",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@types/three": "^0.187.0",
		"astro": "^7.4.2",
		"atom.io": "^0.54.4",
		"konva": "^10.9.1",
		"motion": "^14.9.0",
		"resumability": "^0.0.2",
		"three": "^0.187.0",
		"vite": "^8.3.5"
	},
	"peerDependenciesMeta": {
		"@floating-ui/dom": {
			"optional": true
		},
		"@types/three": {
			"optional": true
		},
		"astro": {
			"optional": true
		},
		"konva": {
			"optional": true
		},
		"motion": {
			"optional": true
		},
		"resumability": {
			"optional": true
		},
		"three": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
