{
	"name": "@atom.io/monorepo",
	"version": "0.0.0",
	"private": true,
	"repository": "https://github.com/jeremybanka/atom.io",
	"license": "MPL-2.0",
	"author": "jeremybanka",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"templates/*"
	],
	"scripts": {
		"build": "dotenvx run -- turbo run build",
		"tonnage": "dotenvx run -- turbo run tonnage --filter=atom.io",
		"tonnage:check": "dotenvx run -- turbo run tonnage:check --filter=atom.io",
		"cov:public": "dotenvx run -- turbo run cov:public",
		"cov:recoverage": "dotenvx run -- turbo run cov:recoverage",
		"dev": "dotenvx run -- turbo run dev",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"hooks:install": "mise x -- hk install --mise",
		"lint": "dotenvx run -- turbo run lint",
		"lint:deps": "pin-checker --ignore-workspaces",
		"lint:eslint": "dotenvx run -- turbo run lint:eslint",
		"lint:fix:eslint": "eslint --fix .",
		"lint:lasertag": "lasertag check",
		"lint:oxlint": "dotenvx run -- turbo run lint:oxlint",
		"lint:types": "dotenvx run -- turbo run lint:types",
		"manifest:test": "dotenvx run -- turbo run manifest:test",
		"changes": "changeset",
		"changes:publish": "bun run build && changeset publish",
		"changes:version": "pnpm --config.verifyDepsBeforeRun=false exec changeset version",
		"test": "CI=true dotenvx run -- turbo run test:once --concurrency=2",
		"test:breaks": "CI=true dotenvx run -- turbo run test:breaks",
		"test:stress:realtime-ipc": "dotenvx run -- turbo run test:stress:realtime-ipc --filter=atom.io",
		"vigilance": "bun scripts/vigilance-bot.bun.ts",
		"workflows": "bun scripts/update-workflows.bun.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dotenvx/dotenvx": "2.29.0",
		"@dprint/json": "0.24.0",
		"@dprint/markdown": "0.24.0",
		"@dprint/oxc": "0.41.0",
		"@dprint/toml": "0.8.0",
		"@typescript-eslint/eslint-plugin": "8.70.1",
		"@typescript-eslint/parser": "8.70.1",
		"@typescript-eslint/utils": "8.70.1",
		"astro-eslint-parser": "3.1.0",
		"dprint": "0.57.4",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.3",
		"dprint-plugin-yaml": "0.6.0",
		"eslint": "10.11.0",
		"eslint-plugin-astro": "3.2.1",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-storybook": "10.6.0",
		"jiti": "2.7.0",
		"lasertag": "0.8.2",
		"oxlint": "1.85.0",
		"oxlint-tsgolint": "7.0.2002",
		"pin-dependencies-checker": "2.7.1",
		"turbo": "2.11.2",
		"typescript": "7.0.2",
		"vitest": "5.0.1"
	},
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": "26.10.0"
	}
}
