{
	"name": "@atom.io/template-preact-svg-editor",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/preact-svg-editor"
	},
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
