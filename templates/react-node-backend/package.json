{
	"name": "@atom.io/template-react-node-backend",
	"version": "0.0.91",
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/react-node-backend"
	},
	"type": "module",
	"scripts": {
		"dev": "concurrently vite ./node/server.ts ./node/authenticator.ts",
		"build": "vite build",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:types",
		"lint:eslint": "eslint --max-warnings 0 .",
		"lint:oxlint": "oxlint --deny-warnings .",
		"lint:types": "tsc -b",
		"preview": "concurrently \"vite preview\" ./node/server.ts ./node/authenticator.ts"
	},
	"dependencies": {
		"atom.io": "workspace:*",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "5.18.6",
		"@dprint/json": "0.23.0",
		"@dprint/markdown": "0.23.2",
		"@dprint/oxc": "0.37.0",
		"@types/node": "26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.1",
		"babel-plugin-react-compiler": "1.0.0",
		"concurrently": "10.0.5",
		"dprint": "0.56.1",
		"dprint-plugin-malva": "0.16.0",
		"eslint": "10.9.1",
		"eslint-plugin-react-refresh": "0.5.5",
		"globals": "17.11.0",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"oxc-transform-react": "0.147.0",
		"typescript": "7.0.2",
		"typescript-eslint": "8.68.0",
		"vite": "8.2.2"
	}
}
