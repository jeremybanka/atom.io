{
	"ui": "tui",
	"globalDependencies": ["tsconfig.json", ".node-version"],
	"tasks": {
		"dev": {
			"persistent": true,
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "docs/agent/**", "agent-docs/**"],
			"inputs": [
				"package.json",
				"tsconfig.json",
				"*.config.ts",
				"src/**",
				"docs/source/**",
				"__scripts__/**"
			]
		},
		"tonnage": {
			"dependsOn": ["build", "^build"],
			"cache": false
		},
		"tonnage:check": {
			"dependsOn": ["build", "^build"],
			"outputs": [],
			"inputs": [
				"package.json",
				"tonnage.config.ts",
				"tonnage-recipes/**",
				"README.md",
				"dist/**"
			]
		},
		"manifest:test": {
			"dependsOn": [],
			"outputs": [],
			"inputs": [
				"**/*.{ts,tsx}"
			]
		},
		"test:once": {
			"dependsOn": ["build"],
			"inputs": [
				"package.json",
				"tsconfig.json",
				"*.config.ts",
				"bin/**",
				"../../mise.toml",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"@atom.io/eslint-plugin#test:once": {
			"dependsOn": ["build", "atom.io#build"]
		},
		"test:stress:realtime-ipc": {
			"dependsOn": ["build"],
			"cache": false,
			"inputs": [
				"package.json",
				"tsconfig.json",
				"*.config.ts",
				"src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"cov": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"],
			"inputs": [
				"tsconfig.json",
				"package.json",
				"*.config.ts",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"cov:recoverage": {
			"dependsOn": ["cov"],
			"cache": false,
			"passThroughEnv": ["RECOVERAGE_CLOUD_TOKEN"]
		},
		"cov:public": {
			"dependsOn": ["^build"],
			"outputs": ["coverage-public/**"],
			"inputs": [
				"tsconfig.json",
				"package.json",
				"*.config.ts",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"test:breakage:prelude": {
			"cache": false
		},
		"test:breakage": {
			"dependsOn": [
				"test:breakage:prelude",
				"^build"
			],
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../.changeset/**",
				"package.json",
				"tsconfig.json",
				"breakage.config.json",
				"*.config.ts",
				"src/**",
				"docs/source/**",
				"__tests__/public/**",
				"__scripts__/**",
				"../../mise.toml",
				"../../tsconfig.json",
				"../../.github/workflows/test.yml",
				"../../.github/actions/setup/action.yml",
				{
					"mode": "jit",
					"globs": [
						".breakage/baseline.json"
					]
				}
			],
			"outputs": []
		},
		"@atom.io/eslint-plugin#test:breakage": {
			"dependsOn": ["test:breakage:prelude", "^build"],
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../.changeset/**",
				"../../package.json",
				"../../pnpm-lock.yaml",
				"../../pnpm-workspace.yaml",
				"../../tsconfig.json",
				{
					"mode": "jit",
					"globs": [".breakage/baseline.json"]
				}
			],
			"outputs": []
		},
		"lint:eslint": {
			"dependsOn": ["^build", "@atom.io/eslint-plugin#build"],
			"inputs": [
				"../../package.json",
				"../../eslint.config.ts",
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"lint:oxlint": {
			"dependsOn": ["^build"],
			"inputs": [
				"../../package.json",
				"../../oxlint.config.ts",
				"package.json",
				"tsconfig.json",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"**/*.d.ts"
			]
		},
		"lint:types": {
			"dependsOn": ["^build"],
			"inputs": [
				"../../package.json",
				"package.json",
				"tsconfig.json",
				"tsconfig.*.json",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"**/*.d.ts"
			]
		},
		"lint": {
			"dependsOn": ["lint:eslint", "lint:oxlint", "lint:types"]
		}
	}
}
