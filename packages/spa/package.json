{
	"name": "@atom.io/spa",
	"version": "0.0.0",
	"description": "An atom.io-driven JSX renderer.",
	"homepage": "https://atom.io.fyi/docs/spa",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/spa"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./dist/development/index.js",
			"import": "./dist/index.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"development": "./dist/development/jsx-runtime.js",
			"import": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"development": "./dist/development/jsx-runtime.js",
			"import": "./dist/jsx-runtime.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"development": "./dist/development/server.js",
			"import": "./dist/server.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"development": "./dist/development/vite.js",
			"import": "./dist/vite.js"
		},
		"./astro": {
			"types": "./dist/astro.d.ts",
			"development": "./dist/development/astro.js",
			"import": "./dist/astro.js"
		},
		"./astro-client": {
			"types": "./dist/astro-client.d.ts",
			"development": "./dist/development/astro-client.js",
			"import": "./dist/astro-client.js"
		},
		"./astro-server": {
			"types": "./dist/astro-server.d.ts",
			"development": "./dist/development/astro-server.js",
			"import": "./dist/astro-server.js"
		},
		"./package.json": "./package.json",
		"./astro-middleware": {
			"types": "./dist/astro-middleware.d.ts",
			"development": "./dist/development/astro-middleware.js",
			"import": "./dist/astro-middleware.js"
		},
		"./astro-application": {
			"types": "./dist/astro-application.d.ts",
			"development": "./dist/development/astro-application.js",
			"import": "./dist/astro-application.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown && node scripts/size.ts",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc -p tsconfig.json && tsc -p __tests__/fixtures/consumer/tsconfig.json",
		"size": "node scripts/size.ts",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check",
		"test": "vitest",
		"test:once": "vitest run --config vitest.config.ts && pnpm test:consumer",
		"test:consumer": "node __tests__/fixtures/consumer/check.ts",
		"test:production": "node scripts/production-test.ts",
		"test:browser": "astro build --root __tests__/astro && node scripts/browser-test.mjs && node scripts/dev-browser-test.mjs",
		"test:browser:dev": "node scripts/dev-browser-test.mjs",
		"cov": "vitest run --config vitest.config.ts --coverage",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx",
		"tonnage": "pnpm readme:write",
		"tonnage:check": "pnpm readme:check"
	},
	"dependencies": {
		"@babel/core": "7.29.7"
	},
	"devDependencies": {
		"@breakage/changesets": "0.1.0",
		"@types/babel__core": "7.20.5",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.0.5",
		"astro": "7.4.4",
		"atom.io": "workspace:*",
		"breakage": "0.10.1",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"happy-dom": "21.0.4",
		"playwright": "1.64.1",
		"preact": "11.1.0",
		"rolldown": "1.2.16",
		"tsdown": "0.23.4",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"astro": "^7.4.2",
		"atom.io": "^0.54.1",
		"vite": "^8.3.5"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
