---
import "@atom.io/devtools/css"
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		{import.meta.env.PROD && (
			<meta http-equiv="Content-Security-Policy" content="connect-src 'none'" />
		)}
		<title>Exhibit ecology</title>
	</head>
	<body>
		<exhibit-sandbox id="ecology" role="main">
			<p role="status">Loading exhibit ecology…</p>
		</exhibit-sandbox>
	</body>
</html>

<style>
:global(html), :global(body), #ecology {
	height: 100%;
	margin: 0;
	color-scheme: light dark;
}
#ecology > p {
	margin: 0;
	padding: 12px;
	font: 14px/1.5 system-ui, sans-serif;
}
#ecology {
	display: block;
}
</style>

<script>
import { mountEcology } from "@atom.io/devtools/ecology"
import { Silo } from "atom.io"
import { IMPLICIT, type RootStore } from "atom.io/internal"
import { sandboxes } from "virtual:atom-io-exhibit-sandboxes"

function hasState(store: RootStore): boolean {
	return (
		store.atoms.size +
			store.readonlySelectors.size +
			store.writableSelectors.size +
			store.families.size >
		0
	)
}

const host = document.querySelector<HTMLElement>(`#ecology`)!
const status = host.querySelector(`p`)!
try {
	const source = decodeURIComponent(location.hash.slice(1))
	const embedded = window.parent !== window
	const load =
		embedded && (import.meta.env.DEV || window.origin === `null`)
			? sandboxes.get(source)
			: undefined
	if (load) {
		const module = await load()
		const implicit = IMPLICIT.STORE
		const exportedSilo = Object.values(module).find(
			(value): value is Silo => value instanceof Silo && hasState(value.store),
		)
		const store = hasState(implicit) ? implicit : exportedSilo?.store
		if (store) {
			const explorer = mountEcology(host, { store })
			status.remove()
			window.addEventListener(`pagehide`, (event) => {
				if (!event.persisted) explorer.dispose()
			})
		} else
			status.textContent = `This exhibit did not initialize any atoms, selectors, or families.`
	} else status.textContent = `No runnable exhibit was selected.`
} catch (error) {
	status.textContent = `This exhibit could not run in the sandbox. ${error instanceof Error ? error.message : String(error)}`
}
</script>
