{
	"name": "resumability",
	"version": "0.0.0",
	"description": "Server-produced values with one-time browser resumption for Astro.",
	"license": "MPL-2.0",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client.js",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./astro": {
			"types": "./dist/astro.d.ts",
			"default": "./dist/astro.js"
		},
		"./Resumption.astro": "./dist/Resumption.astro",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown && node scripts/size.ts",
		"lint:types": "tsc -p tsconfig.json",
		"lint:eslint": "eslint src __tests__ scripts exhibits tsdown.config.ts",
		"lint:oxlint": "oxlint src __tests__ scripts exhibits tsdown.config.ts",
		"test:once": "vitest run",
		"cov": "vitest run --coverage",
		"test:browser": "astro build --root __tests__/astro && node scripts/browser-test.mjs && node scripts/browser-test.mjs --dev",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx",
		"tonnage": "pnpm readme:write",
		"tonnage:check": "pnpm readme:check",
		"test:browser:dev": "node scripts/browser-test.mjs --dev",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check"
	},
	"dependencies": {
		"@babel/core": "7.29.7"
	},
	"devDependencies": {
		"@breakage/changesets": "0.1.0",
		"@types/babel__core": "7.20.5",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"astro": "7.4.2",
		"atom.io": "workspace:*",
		"breakage": "0.10.1",
		"esbuild": "0.28.2",
		"happy-dom": "21.0.4",
		"playwright": "1.64.1",
		"tsdown": "0.23.3",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"astro": "^7.4.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
