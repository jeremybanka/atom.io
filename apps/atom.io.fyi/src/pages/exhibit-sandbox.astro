---
import "@atom.io/devtools/css"
import "../components/exhibit-preview.css"
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Live exhibit</title>
	</head>
	<body>
		<exhibit-app-mount id="app" inert></exhibit-app-mount>
		<section id="ecology" aria-label="State ecology" hidden>
			<p role="status">Loading exhibit ecology…</p>
		</section>
		<preview-desktop
			id="preview"
			role="region"
			aria-label="Component preview"
			hidden
		>
			<preview-viewport>
				<preview-window>
					<p id="preview-status" role="status">Loading preview…</p>
					<preview-mount id="preview-mount"></preview-mount>
				</preview-window>
			</preview-viewport>
			<img id="preview-framework" alt="" hidden />
		</preview-desktop>
	</body>
</html>

<style>
:global(html), body {
	block-size: 100%;
	margin: 0;
	color-scheme: light dark;
}
body {
	display: grid;
	grid-template: minmax(0, 1fr) / minmax(0, 1fr);
	overflow: hidden;
}
body[data-exhibit-view="both"] {
	grid-template-columns: var(--exhibit-ecology-width) minmax(0, 1fr);
	> #preview {
		border-inline-start: 1px solid var(--exhibit-border-color);
	}
}
#app {
	position: fixed;
	inset: 0;
	visibility: hidden;
}
#ecology {
	min-inline-size: 0;
	> p {
		margin: 0;
		padding: 12px;
		font: 14px/1.5 system-ui, sans-serif;
	}
}
</style>

<script>
import "../components/exhibit-sandbox.ts"
</script>
