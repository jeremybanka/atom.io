{
	"ui": "tui",
	"globalDependencies": ["tsconfig.json", ".node-version"],
	"tasks": {
		"pack:breakage": {
			"dependsOn": ["build"],
			"cache": false,
			"outputs": [".breakage/package.tgz"]
		},
		"test:breakage:peers": {
			"dependsOn": ["pack:breakage", "^pack:breakage"],
			"cache": false,
			"outputs": []
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "docs/agent/**", "agent-docs/**"],
			"inputs": [
				"package.json",
				"tsconfig.json",
				"*.config.ts",
				"src/**",
				"node/**",
				"tests/**",
				"docs/source/**",
				"__scripts__/**"
			]
		},
		"readme:write": {
			"dependsOn": [
				"build",
				"^build"
			],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../scripts/readme/**",
				"../../packages/atom.io/docs/source/exhibits/**",
				"../../packages/create-atom.io/src/create-atom-options.ts"
			],
			"cache": false
		},
		"atom.io#readme:write": {
			"dependsOn": [
				"build",
				"^build",
				"@atom.io/react#build",
				"@atom.io/realtime#build"
			],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../scripts/readme/**",
				"../../packages/atom.io/docs/source/exhibits/**",
				"../../packages/create-atom.io/src/create-atom-options.ts"
			],
			"cache": false
		},
		"readme:check": {
			"dependsOn": [
				"build",
				"^build"
			],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../scripts/readme/**",
				"../../packages/atom.io/docs/source/exhibits/**",
				"../../packages/create-atom.io/src/create-atom-options.ts"
			]
		},
		"atom.io#readme:check": {
			"dependsOn": [
				"build",
				"^build",
				"@atom.io/react#build",
				"@atom.io/realtime#build"
			],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../scripts/readme/**",
				"../../packages/atom.io/docs/source/exhibits/**",
				"../../packages/create-atom.io/src/create-atom-options.ts"
			]
		},
		"manifest:test": {
			"dependsOn": [],
			"outputs": [],
			"inputs": [
				"**/*.{ts,tsx}"
			]
		},
		"test:once": {
			"dependsOn": ["build", "^build"],
			"inputs": [
				"package.json",
				"tsconfig.json",
				"*.config.ts",
				"bin/**",
				"../../mise.toml",
				"src/**",
				"node/**",
				"tests/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts",
				"peer-environments/coordinated-solid2/package.json",
				"peer-environments/coordinated-solid2/pnpm-lock.yaml",
				"peer-environments/coordinated-solid2/pnpm-workspace.yaml"
			]
		},
		"atom.io#test:once": {
			"dependsOn": ["build", "@atom.io/react#build"],
			"inputs": [
				"package.json",
				"tsconfig.json",
				"*.config.ts",
				"bin/**",
				"../../mise.toml",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts"
			]
		},
		"@atom.io/eslint-plugin#test:once": {
			"dependsOn": ["build", "atom.io#build"]
		},
		"test:stress:realtime-ipc": {
			"dependsOn": ["build", "@atom.io/react#build"],
			"cache": false,
			"inputs": [
				"package.json",
				"tsconfig.json",
				"*.config.ts",
				"src/**",
				"__tests__/**",
				"__scripts__/**"
			]
		},
		"cov": {
			"dependsOn": ["build", "^build"],
			"outputs": ["coverage/**"],
			"inputs": [
				"tsconfig.json",
				"package.json",
				"*.config.ts",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts",
				"peer-environments/coordinated-solid2/package.json",
				"peer-environments/coordinated-solid2/pnpm-lock.yaml",
				"peer-environments/coordinated-solid2/pnpm-workspace.yaml"
			]
		},
		"cov:recoverage": {
			"dependsOn": ["cov"],
			"cache": false,
			"passThroughEnv": ["RECOVERAGE_CLOUD_TOKEN", "RECOVERAGE_CLOUD_URL"]
		},
		"cov:public": {
			"dependsOn": ["build", "^build"],
			"outputs": ["coverage-public/**"],
			"inputs": [
				"tsconfig.json",
				"package.json",
				"*.config.ts",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts",
				"peer-environments/coordinated-solid2/package.json",
				"peer-environments/coordinated-solid2/pnpm-lock.yaml",
				"peer-environments/coordinated-solid2/pnpm-workspace.yaml"
			]
		},
		"test:breakage:prelude": {
			"cache": false
		},
		"test:breakage": {
			"dependsOn": [
				"test:breakage:prelude",
				"^build",
				"build",
				"@atom.io/react#build"
			],
			"cache": true,
			"inputs": [
				"../../scripts/breakage-certify.ts",
				"../../scripts/breakage-release.ts",
				"../../packages/*/package.json",
				"../../apps/*/package.json",
				"../../templates/*/package.json",
				"$TURBO_DEFAULT$",
				"../../.changeset/**",
				"package.json",
				"tsconfig.json",
				"breakage.config.json",
				"*.config.ts",
				"src/**",
				"docs/source/**",
				"__tests__/public/**",
				"__scripts__/**",
				"../../mise.toml",
				"../../tsconfig.json",
				"../../.github/workflows/test.yml",
				"../../.github/actions/setup/action.yml",
				{
					"mode": "jit",
					"globs": [
						".breakage/baseline.json"
					]
				},
				"../../.github/workflows/breakage.yml",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts"
			],
			"outputs": []
		},
		"@atom.io/eslint-plugin#test:breakage": {
			"dependsOn": ["test:breakage:prelude", "^build"],
			"cache": true,
			"inputs": [
				"../../scripts/breakage-certify.ts",
				"../../scripts/breakage-release.ts",
				"../../packages/*/package.json",
				"../../apps/*/package.json",
				"../../templates/*/package.json",
				"$TURBO_DEFAULT$",
				"../../.changeset/**",
				"../../package.json",
				"../../pnpm-lock.yaml",
				"../../pnpm-workspace.yaml",
				"../../tsconfig.json",
				"../../mise.toml",
				"../../.github/workflows/test.yml",
				"../../.github/actions/setup/action.yml",
				{
					"mode": "jit",
					"globs": [
						".breakage/baseline.json"
					]
				},
				"../../.github/workflows/breakage.yml",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts"
			],
			"outputs": []
		},
		"lint:eslint": {
			"dependsOn": ["^build", "@atom.io/eslint-plugin#build"],
			"inputs": [
				"../../package.json",
				"../../eslint.config.ts",
				"**/package.json",
				"tsconfig.json",
				"src/**",
				"node/**",
				"tests/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts"
			]
		},
		"lint:oxlint": {
			"dependsOn": ["^build"],
			"inputs": [
				"../../package.json",
				"../../oxlint.config.ts",
				"package.json",
				"tsconfig.json",
				"src/**",
				"node/**",
				"tests/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"**/*.d.ts",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts"
			]
		},
		"lint:types": {
			"dependsOn": ["^build"],
			"inputs": [
				"../../package.json",
				"package.json",
				"tsconfig.json",
				"tsconfig.*.json",
				"src/**",
				"node/**",
				"tests/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"**/*.d.ts",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts"
			]
		},
		"lint": {
			"dependsOn": ["lint:eslint", "lint:oxlint", "lint:types"]
		},
		"atom.io#cov": {
			"dependsOn": ["build", "@atom.io/react#build"],
			"outputs": ["coverage/**"],
			"inputs": [
				"tsconfig.json",
				"package.json",
				"*.config.ts",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts"
			]
		},
		"atom.io#cov:public": {
			"dependsOn": ["build", "@atom.io/react#build"],
			"outputs": ["coverage-public/**"],
			"inputs": [
				"tsconfig.json",
				"package.json",
				"*.config.ts",
				"src/**",
				"docs/source/**",
				"__tests__/**",
				"__scripts__/**",
				"../../scripts/define-vitest-config.ts",
				"../../scripts/runtime-copies.ts",
				"../../scripts/test-helpers.ts",
				"../../scripts/react-test-helpers.ts",
				"../../scripts/test-postgres.ts"
			]
		},
		"test:packaging": {
			"dependsOn": ["build", "^build"],
			"cache": false
		},
		"atom.io#lint:types": {
			"dependsOn": [
				"@atom.io/realtime#build",
				"@atom.io/react#build"
			]
		},
		"atom.io#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../realtime/docs/source/**"
			],
			"outputs": [
				"dist/**",
				"docs/agent/**"
			]
		}
	}
}
