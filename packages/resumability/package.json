{
	"name": "resumability",
	"version": "0.0.2",
	"description": "Server-produced values with one-time browser resumption for Astro.",
	"homepage": "https://github.com/jeremybanka/atom.io/tree/main/packages/resumability#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/resumability"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/client.js",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./astro": {
			"types": "./dist/astro.d.ts",
			"default": "./dist/astro.js"
		},
		"./Resumption.astro": "./dist/Resumption.astro",
		"./package.json": "./package.json",
		"./astro-client": {
			"types": "./dist/astro-client.d.ts",
			"default": "./dist/astro-client.js"
		},
		"./astro-server": {
			"types": "./dist/astro-server.d.ts",
			"default": "./dist/astro-server.js"
		},
		"./astro-middleware": {
			"types": "./dist/astro-middleware.d.ts",
			"default": "./dist/astro-middleware.js"
		}
	},
	"main": "./dist/index.js",
	"browser": "./dist/client.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown && node scripts/size.ts",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc -p tsconfig.json",
		"size": "node scripts/size.ts",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check",
		"test": "vitest",
		"test:once": "vitest run && pnpm test:consumer",
		"test:consumer": "node __tests__/fixtures/consumer/check.ts",
		"test:browser": "astro build --root __tests__/astro && node scripts/browser-test.mjs && node scripts/browser-test.mjs --dev",
		"test:browser:dev": "node scripts/browser-test.mjs --dev",
		"cov": "vitest run --coverage",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx"
	},
	"dependencies": {
		"@babel/core": "8.1.2",
		"parse5-sax-parser": "8.0.1"
	},
	"devDependencies": {
		"@breakage/changesets": "0.1.0",
		"@types/babel__core": "7.20.5",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"astro": "7.4.11",
		"atom.io": "workspace:*",
		"breakage": "0.10.2",
		"esbuild": "0.28.2",
		"eslint": "10.14.0",
		"happy-dom": "21.0.4",
		"playwright": "1.65.0",
		"tsdown": "0.23.7",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"astro": "^7.4.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
