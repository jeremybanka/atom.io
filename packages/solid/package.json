{
	"name": "@atom.io/solid",
	"version": "0.1.1",
	"description": "Solid bindings for atom.io.",
	"homepage": "https://atom.io.fyi/docs/solid",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/solid"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc && tsc -p __tests__/tsconfig.json",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check",
		"test": "pnpm test:prepare:solid2 && vitest",
		"test:once": "pnpm test:prepare:solid2 && vitest run --config vitest.dist.config.ts && pnpm test:consumer",
		"test:once:public": "pnpm test:prepare:solid2 && vitest run --config vitest.public.config.ts",
		"test:consumer": "node __tests__/fixtures/consumer/check.ts",
		"cov": "pnpm test:prepare:solid2 && vitest run --config vitest.total-coverage.config.ts --coverage",
		"cov:public": "pnpm test:prepare:solid2 && vitest run --config vitest.public-coverage.config.ts --coverage",
		"cov:recoverage": "recoverage",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx",
		"test:prepare:solid2": "pnpm --dir peer-environments/coordinated-solid2 install --frozen-lockfile --ignore-scripts"
	},
	"devDependencies": {
		"@breakage/changesets": "0.1.0",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"atom.io": "workspace:*",
		"breakage": "0.10.0",
		"eslint": "10.13.0",
		"happy-dom": "21.0.4",
		"recoverage": "0.1.20",
		"solid-js": "1.9.17",
		"tsdown": "0.23.2",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"atom.io": "^0.53.3 || ^0.54.0",
		"solid-js": "^1.9.0 || 2.0.0-rc.17 || 2.0.0-rc.18"
	},
	"publishConfig": {
		"access": "public"
	}
}
