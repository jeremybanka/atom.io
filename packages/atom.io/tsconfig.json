{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"target": "ES2023",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"allowArbitraryExtensions": true,
		"types": [
			"vitest/globals"
		],
		"lib": [
			"DOM",
			"ESNext"
		],
		"noEmit": true,
		"declaration": true,
		"allowJs": false,
		"isolatedDeclarations": true,
		"paths": {
			"atom.io": [
				"./src/main"
			],
			"atom.io/*": [
				"./src/*"
			],
			"@atom.io/react": [
				"../react/src"
			],
			"@atom.io/solid": [
				"../solid/src"
			],
			"@atom.io/react-devtools": [
				"../react-devtools/src"
			],
			"@atom.io/realtime": [
				"../realtime/src/core"
			],
			"@atom.io/realtime/*": [
				"../realtime/src/*"
			]
		}
	},
	"include": [
		"src",
		"**/*.config.ts",
		"__tests__",
		"__scripts__",
		"__stories__",
		"__unstable__",
		"tonnage-recipes",
		".storybook/*.ts"
	],
	"contentMappers": [
		{
			"package": "reylo",
			"extensions": [
				".sql",
				".reylo.yaml",
				".reylo.yml"
			]
		}
	],
	"exclude": [
		"__tests__/private/experiments/stateless/notify_update.sql"
	]
}
