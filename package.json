{
	"name": "@atom.io/monorepo",
	"version": "0.0.0",
	"type": "module",
	"repository": "https://github.com/jeremybanka/atom.io",
	"author": "jeremybanka",
	"license": "MPL-2.0",
	"private": true,
	"packageManager": "pnpm@11.23.0",
	"engines": {
		"node": "26.7.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"templates/*"
	],
	"scripts": {
		"build": "dotenvx run -- turbo run build",
		"cov:public": "dotenvx run -- turbo run cov:public",
		"cov:recoverage": "dotenvx run -- turbo run cov:recoverage",
		"dev": "dotenvx run -- turbo run dev",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"hooks:install": "mise x -- hk install --mise",
		"lint": "dotenvx run -- turbo run lint",
		"lint:deps": "pin-checker --ignore-workspaces",
		"lint:eslint": "dotenvx run -- turbo run lint:eslint",
		"lint:fix:eslint": "eslint --fix .",
		"lint:lasertag": "lasertag check",
		"lint:oxlint": "dotenvx run -- turbo run lint:oxlint",
		"lint:types": "dotenvx run -- turbo run lint:types",
		"manifest:test": "dotenvx run -- turbo run manifest:test",
		"changes": "changeset",
		"changes:publish": "bun run build && changeset publish",
		"changes:version": "pnpm --config.verifyDepsBeforeRun=false exec changeset version",
		"test": "bun run test:corpus-tooling && CI=true dotenvx run -- turbo run test:once --concurrency=2",
		"test:corpus-tooling": "bun test scripts/large-document-corpus.test.ts",
		"test:large-document": "bun scripts/large-document-corpus.bun.ts test",
		"corpus:large:prepare": "bun scripts/large-document-corpus.bun.ts prepare",
		"corpus:large:verify": "bun scripts/large-document-corpus.bun.ts verify",
		"corpus:large:derive": "bun scripts/large-document-corpus.bun.ts derive",
		"test:breaks": "CI=true dotenvx run -- turbo run test:breaks",
		"test:stress:realtime-ipc": "dotenvx run -- turbo run test:stress:realtime-ipc --filter=atom.io",
		"vigilance": "bun scripts/vigilance-bot.bun.ts",
		"workflows": "bun scripts/update-workflows.bun.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.0",
		"@changesets/config": "4.0.0",
		"@dotenvx/dotenvx": "2.21.0",
		"@dprint/json": "0.23.0",
		"@dprint/markdown": "0.22.1",
		"@dprint/oxc": "0.36.0",
		"@dprint/toml": "0.8.0",
		"@typescript-eslint/eslint-plugin": "8.67.0",
		"@typescript-eslint/parser": "8.67.0",
		"@typescript-eslint/utils": "8.67.0",
		"astro-eslint-parser": "3.1.0",
		"dprint": "0.56.1",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.3",
		"dprint-plugin-yaml": "0.6.0",
		"eslint": "10.9.0",
		"eslint-plugin-astro": "3.1.0",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-storybook": "10.5.10",
		"jiti": "2.7.0",
		"lasertag": "0.7.0",
		"oxlint": "1.79.0",
		"oxlint-tsgolint": "7.0.2001",
		"pin-dependencies-checker": "2.7.1",
		"turbo": "2.10.11",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
