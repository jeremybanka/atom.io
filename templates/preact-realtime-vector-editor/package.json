{
	"name": "@atom.io/template-preact-realtime-vector-editor",
	"version": "0.1.1",
	"description": "A realtime collaborative vector editor built with Atom.io Mosaic Domains and Preact.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/preact-realtime-vector-editor"
	},
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently vite \"node --watch node/server.ts\"",
		"build": "tsc -b && vite build",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:lasertag && npm run lint:types",
		"lint:eslint": "eslint --max-warnings 0 .",
		"lint:lasertag": "lasertag check \"src/**/*.module.css\"",
		"lint:oxlint": "oxlint --deny-warnings .",
		"lint:types": "tsc -b",
		"preview": "concurrently \"vite preview\" \"node node/server.ts\"",
		"test": "vitest run",
		"test:once": "vitest run"
	},
	"dependencies": {
		"@atom.io/react": "workspace:*",
		"@atom.io/realtime": "workspace:*",
		"@atom.io/template-preact-svg-editor": "workspace:*",
		"atom.io": "workspace:*",
		"preact": "11.1.0",
		"socket.io": "4.8.4",
		"socket.io-client": "4.8.4"
	},
	"devDependencies": {
		"@atom.io/eslint-plugin": "workspace:*",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.28.2",
		"@dprint/oxc": "0.48.0",
		"@preact/preset-vite": "2.10.6",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/parser": "8.72.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"concurrently": "10.0.6",
		"dprint": "0.64.3",
		"dprint-plugin-malva": "0.16.0",
		"eslint": "10.13.0",
		"happy-dom": "21.0.4",
		"lasertag": "0.8.10",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
