{
	"name": "@atom.io/eslint-plugin",
	"version": "0.0.0",
	"description": "ESLint rules for atom.io state and transaction declarations.",
	"homepage": "https://atom.io.fyi/docs/eslint-plugin",
	"type": "module",
	"sideEffects": false,
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/eslint-plugin"
	},
	"files": [
		"dist",
		"src"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc"
	},
	"peerDependencies": {
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": ">=9.0.0"
	},
	"devDependencies": {
		"@types/estree": "1.0.9",
		"@types/node": "26.5.0",
		"@typescript-eslint/parser": "8.70.0",
		"eslint": "10.10.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"typescript-eslint-typescript": "npm:typescript@6.0.3"
	},
	"dependencies": {
		"@typescript-eslint/types": "8.70.0",
		"@typescript-eslint/utils": "8.70.0"
	}
}
