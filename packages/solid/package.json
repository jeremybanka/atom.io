{
	"name": "@atom.io/solid",
	"version": "0.0.0",
	"description": "Solid bindings for atom.io.",
	"homepage": "https://atom.io.fyi/docs/solid",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/solid"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc && tsc -p __tests__/tsconfig.json",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check",
		"test": "vitest",
		"test:once": "vitest run --config vitest.dist.config.ts && pnpm test:consumer",
		"test:once:public": "vitest run --config vitest.public.config.ts",
		"test:consumer": "node --test --conditions=browser __tests__/fixtures/consumer/runtime.ts && tsc -p __tests__/fixtures/consumer/tsconfig.json",
		"cov": "vitest run --config vitest.total-coverage.config.ts --coverage",
		"cov:public": "vitest run --config vitest.public-coverage.config.ts --coverage"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"atom.io": "workspace:*",
		"breakage": "0.8.5",
		"eslint": "10.13.0",
		"happy-dom": "21.0.3",
		"solid-js": "1.9.17",
		"tsdown": "0.23.1",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"atom.io": "^0.53.3 || ^0.54.0",
		"solid-js": "^1.9.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
