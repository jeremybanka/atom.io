{
	"name": "@atom.io/template-react-node-backend",
	"version": "0.0.107",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/react-node-backend"
	},
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently vite ./node/server.ts ./node/authenticator.ts",
		"build": "vite build",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:types",
		"lint:eslint": "eslint --max-warnings 0 .",
		"lint:oxlint": "oxlint --deny-warnings .",
		"lint:types": "tsc -b",
		"preview": "concurrently \"vite preview\" ./node/server.ts ./node/authenticator.ts"
	},
	"dependencies": {
		"@atom.io/react": "workspace:*",
		"atom.io": "workspace:*",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@atom.io/eslint-plugin": "workspace:*",
		"@dprint/json": "0.26.0",
		"@dprint/markdown": "0.29.0",
		"@dprint/oxc": "0.49.1",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitejs/plugin-react": "6.3.0",
		"babel-plugin-react-compiler": "1.0.0",
		"concurrently": "10.0.7",
		"dprint": "0.64.3",
		"dprint-plugin-malva": "0.16.0",
		"eslint": "10.14.0",
		"oxc-transform-react": "0.158.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2006",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "8.3.7"
	},
	"publishConfig": {
		"access": "public"
	}
}
