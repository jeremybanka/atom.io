{
	"name": "atom.io.fyi",
	"version": "0.2.102",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "./scripts/rm-dev-lock.node.ts && astro dev",
		"build": "bun run build:docs && bun run build:astro",
		"build:icons": "./scripts/render-dz2-icons.ts",
		"build:icons:spa": "node scripts/render-spa-icons.mjs",
		"build:docs": "node ../../packages/atom.io/__scripts__/agent-docs.node.ts --site",
		"build:astro": "astro build",
		"preview": "wrangler dev",
		"deploy": "wrangler deploy",
		"astro": "astro",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc",
		"test:once": "node --test src/components/*.test.ts",
		"test:browser": "node scripts/test-spa.browser.mjs",
		"test:browser:dev": "node scripts/test-spa.browser.mjs --dev"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.4.6",
		"@astrojs/markdown-remark": "7.3.6",
		"@astrojs/mdx": "8.1.3",
		"@atom.io/spa": "workspace:*",
		"@atom.io/spa-devtools": "workspace:*",
		"@babel/parser": "8.1.0",
		"@babel/types": "8.1.0",
		"@pierre/highlights": "0.4.0",
		"astro": "7.4.7",
		"atom.io": "workspace:*",
		"motion": "14.10.1",
		"three": "0.187.0",
		"tsdoc.json": "0.6.12"
	},
	"devDependencies": {
		"@atom.io/exhibits": "workspace:*",
		"@atom.io/realtime": "workspace:*",
		"@types/bun": "npm:bun-types@1.4.4",
		"@types/three": "0.187.0",
		"concurrently": "10.0.6",
		"eslint": "10.14.0",
		"lasertag": "0.8.10",
		"playwright": "1.65.0",
		"typescript": "7.0.2",
		"wrangler": "4.158.0"
	},
	"engines": {
		"node": "26.13.0"
	}
}
