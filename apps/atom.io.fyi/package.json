{
	"name": "atom.io.fyi",
	"version": "0.2.118",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "./scripts/rm-dev-lock.node.ts && astro dev",
		"build": "bun run build:docs && bun run build:astro",
		"build:icons": "./scripts/render-dz2-icons.ts",
		"build:icons:spa": "node scripts/render-spa-icons.ts",
		"build:docs": "node ../../packages/atom.io/__scripts__/agent-docs.node.ts --site",
		"build:astro": "astro build",
		"preview": "wrangler dev",
		"deploy": "wrangler deploy",
		"deploy:preview": "wrangler versions upload --preview-alias main",
		"astro": "astro",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc",
		"test:once": "node --test src/components/*.test.ts",
		"test:browser": "node scripts/test-spa.browser.ts",
		"test:browser:dev": "node scripts/test-spa.browser.ts --dev",
		"test:browser:install": "playwright install --only-shell chromium"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.4.9",
		"@astrojs/markdown-remark": "7.3.10",
		"@astrojs/mdx": "8.1.6",
		"@atom.io/devtools": "workspace:*",
		"@atom.io/react": "workspace:*",
		"@atom.io/solid": "workspace:*",
		"@atom.io/spa": "workspace:*",
		"@babel/parser": "8.1.3",
		"@babel/types": "8.1.3",
		"@pierre/highlights": "0.5.2",
		"@solidjs/web": "2.0.3",
		"astro": "7.4.13",
		"atom.io": "workspace:*",
		"motion": "14.14.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"solid-js": "2.0.3",
		"three": "0.187.0"
	},
	"devDependencies": {
		"@atom.io/exhibits": "workspace:*",
		"@solidjs/compiler": "2.0.2",
		"@types/bun": "npm:bun-types@1.4.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.187.0",
		"esbuild": "0.28.2",
		"eslint": "10.15.0",
		"lasertag": "0.9.1",
		"playwright": "1.65.1",
		"tsdoc.json": "0.6.12",
		"typescript": "7.0.2",
		"wrangler": "4.167.0"
	},
	"engines": {
		"node": "26.13.1"
	}
}
