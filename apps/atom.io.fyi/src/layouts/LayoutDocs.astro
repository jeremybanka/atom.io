---
import Layout from "./Layout.astro"
import { DocsNavigation } from "../components/DocsNavigation.tsx"
import css from "./LayoutDocs.module.css"
---

<Layout>
	<docs-layout class={css.class}>
		<DocsNavigation
			pathname={Astro.url.pathname}
			client:load
			transition:persist="docs-navigation"
		/>
		<article>
			<slot />
		</article>
	</docs-layout>
</Layout>
