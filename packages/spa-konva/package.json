{
	"name": "@atom.io/spa-konva",
	"version": "0.0.1",
	"description": "Reactive konva JSX bindings for atom.io SPA.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/spa-konva"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"lint:types": "tsc -p tsconfig.json",
		"test:once": "vitest run",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx"
	},
	"devDependencies": {
		"@atom.io/spa": "workspace:*",
		"atom.io": "workspace:*",
		"konva": "10.9.1",
		"tsdown": "0.23.4",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"@atom.io/spa": "^0.0.1",
		"atom.io": "^0.54.1",
		"konva": "^10.9.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
