{
	"extends": ["config:recommended"],
	"automerge": true,
	"branchConcurrentLimit": 9,
	"ignoreScripts": true,
	"internalChecksFilter": "strict",
	"minimumReleaseAge": "1 day",
	"postUpdateOptions": ["pnpmDedupe"],
	"postUpgradeTasks": {
		"commands": [
			"pnpm install --frozen-lockfile",
			"pnpm readme:write"
		],
		"executionMode": "branch",
		"fileFilters": ["packages/*/README.md"],
		"installTools": {
			"node": {},
			"pnpm": {}
		}
	},
	"prConcurrentLimit": 3,
	"prHourlyLimit": 9,
	"pruneBranchAfterAutomerge": true,
	"pruneStaleBranches": true,
	"statusCheckWhen": { "minimumReleaseAge": "never" },
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github\\/actions\\/setup\\/action\\.yml$/"],
			"matchStrings": [
				"uses: jdx\\/mise-action@\\S+(?:\\s+#.*)?\\s+      with:\\s+        version: (?<currentValue>\\S+)"
			],
			"depNameTemplate": "jdx/mise",
			"datasourceTemplate": "github-releases",
			"versioningTemplate": "semver-coerced"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github\\/workflows\\/renovate\\.yml$/"],
			"matchStrings": [
				"renovate-version: (?<currentValue>\\S+)"
			],
			"depNameTemplate": "ghcr.io/renovatebot/renovate",
			"datasourceTemplate": "docker",
			"versioningTemplate": "semver-coerced"
		}
	],
	"packageRules": [
		{
			"description": "Keep the ESLint 9 peer environment current within its supported major.",
			"matchFileNames": [
				"packages/eslint-plugin/peer-environments/eslint9/package.json"
			],
			"matchPackageNames": ["eslint"],
			"allowedVersions": "^9.0.0"
		},
		{
			"description": "Keep the ESLint 10 peer environment current within its supported major.",
			"matchFileNames": [
				"packages/eslint-plugin/peer-environments/eslint10/package.json"
			],
			"matchPackageNames": ["eslint"],
			"allowedVersions": "^10.0.0"
		},
		{
			"description": "Keep ESLint peer environments on the supported parser major.",
			"matchFileNames": [
				"packages/eslint-plugin/peer-environments/*/package.json"
			],
			"matchPackageNames": ["@typescript-eslint/parser"],
			"allowedVersions": "^8.0.0"
		},
		{
			"description": "Keep ESLint peer environments on TypeScript 6.0 within declared support (<6.1).",
			"matchFileNames": [
				"packages/eslint-plugin/peer-environments/*/package.json"
			],
			"matchPackageNames": ["typescript"],
			"allowedVersions": "~6.0.0"
		},
		{
			"description": "Keep React 18 runtimes and types current within their supported major.",
			"matchFileNames": [
				"packages/{react,react-devtools}/peer-environments/*-react18/package.json"
			],
			"matchPackageNames": [
				"react",
				"react-dom",
				"@types/react",
				"@types/react-dom"
			],
			"allowedVersions": "^18.0.0"
		},
		{
			"description": "Keep React 19 runtimes and types current within their supported major.",
			"matchFileNames": [
				"packages/{react,react-devtools}/peer-environments/*-react19/package.json"
			],
			"matchPackageNames": [
				"react",
				"react-dom",
				"@types/react",
				"@types/react-dom"
			],
			"allowedVersions": "^19.0.0"
		},
		{
			"description": "Keep Solid peer environments current within the supported 1.x range.",
			"matchFileNames": [
				"packages/solid/peer-environments/*-solid1.9/package.json"
			],
			"matchPackageNames": ["solid-js"],
			"allowedVersions": "^1.9.0"
		},
		{
			"description": "New Solid RC support needs an explicit peer declaration, tested peer environments, and a changeset.",
			"matchManagers": [
				"npm"
			],
			"matchFileNames": [
				"packages/solid/package.json"
			],
			"matchPackageNames": ["solid-js"],
			"matchDepTypes": [
				"peerDependencies"
			],
			"enabled": false
		},
		{
			"description": "Propose the next Solid RC after the one-day delay; replacing earlier RC support requires an explicit peer declaration and a changeset.",
			"matchFileNames": [
				"packages/solid/peer-environments/*-solid2/package.json"
			],
			"matchPackageNames": ["solid-js"],
			"allowedVersions": "/^2\\.0\\.0-rc\\.\\d+$/",
			"ignoreUnstable": false,
			"respectLatest": false,
			"groupName": "Solid 2 peer environments",
			"matchDepTypes": [
				"dependencies"
			],
			"automerge": false
		},
		{
			"description": "Keep released React bindings representatives on the 0.1 compatibility era.",
			"matchFileNames": [
				"packages/react-devtools/peer-environments/released-bindings-react{18,19}/package.json"
			],
			"matchPackageNames": ["@atom.io/react"],
			"allowedVersions": "^0.1"
		},
		{
			"description": "Keep released SDK representatives on the 0.53 compatibility era.",
			"matchFileNames": ["packages/*/peer-environments/released-*/package.json"],
			"matchPackageNames": ["atom.io"],
			"allowedVersions": "^0.53.3"
		},
		{
			"matchPackageNames": ["dprint", "@dprint/*", "/^dprint-plugin-/"],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'Dprint'",
					"pnpm readme:write"
				],
				"executionMode": "branch",
				"fileFilters": ["packages/*/README.md", ".correctly/**"],
				"installTools": { "node": {}, "pnpm": {} }
			}
		},
		{
			"matchPackageNames": ["pnpm"],
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'pnpm workspace'",
					"pnpm readme:write"
				],
				"executionMode": "branch",
				"fileFilters": ["packages/*/README.md", ".correctly/**"],
				"installTools": { "node": {}, "pnpm": {} }
			}
		},
		{
			"matchPackageNames": [
				"@breakage/changesets",
				"@correctlyjs/schemars",
				"atom.io",
				"breakage",
				"comline",
				"correctly",
				"dprint-plugin-mdx",
				"galley.md",
				"lasertag",
				"rationality",
				"recoverage",
				"takua",
				"tonnage",
				"treetrunks",
				"tsdoc.json"
			],
			"minimumReleaseAge": null,
			"matchDatasources": [
				"npm"
			],
			"description": "Exempt consumed jeremybanka packages at every version; keep aligned with pnpm-workspace.yaml"
		},
		{
			"matchManagers": ["github-actions"],
			"dependencyDashboardApproval": true
		},
		{
			"matchDepNames": ["jdx/mise"],
			"dependencyDashboardApproval": true,
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'Mise'",
					"pnpm readme:write"
				],
				"executionMode": "branch",
				"fileFilters": ["packages/*/README.md", ".correctly/**"],
				"installTools": { "node": {}, "pnpm": {} }
			}
		},
		{
			"matchPackageNames": ["tsdown", "@tsdown/css"],
			"groupName": "tsdown"
		},
		{
			"matchPackageNames": ["drizzle-kit", "drizzle-orm"],
			"groupName": "drizzle",
			"description": "Allow numbered v1.0 release candidates and stable releases.",
			"allowedVersions": "/^(\\d+\\.\\d+\\.\\d+|1\\.0\\.0-rc\\.\\d+)$/",
			"ignoreUnstable": false,
			"respectLatest": false
		},
		{
			"matchPackageNames": [
				"renovatebot/github-action",
				"ghcr.io/renovatebot/renovate"
			],
			"dependencyDashboardApproval": true,
			"groupName": "renovate",
			"postUpgradeTasks": {
				"commands": [
					"pnpm install --frozen-lockfile",
					"pnpm exec correctly schemas pull --association 'Renovate'",
					"pnpm readme:write"
				],
				"executionMode": "branch",
				"fileFilters": ["packages/*/README.md", ".correctly/**"],
				"installTools": {
					"node": {},
					"pnpm": {}
				}
			}
		},
		{
			"matchPackageNames": [
				"changesets/action",
				"@changesets/cli",
				"@changesets/config"
			],
			"groupName": "changesets"
		},
		{
			"matchPackageNames": ["eslint-plugin-astro", "astro-eslint-parser"],
			"groupName": "astro eslint"
		}
	]
}
