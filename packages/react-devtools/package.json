{
	"name": "@atom.io/react-devtools",
	"version": "0.1.0",
	"description": "React developer tools for atom.io stores.",
	"homepage": "https://atom.io.fyi/docs/react-devtools",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/react-devtools"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./css": {
			"types": "./css.d.ts",
			"import": "./dist/style.css"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"css.d.ts"
	],
	"scripts": {
		"build": "tsdown",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc && tsc -p __tests__/tsconfig.json",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check",
		"test": "vitest",
		"test:once": "vitest run --config vitest.dist.config.ts && pnpm test:consumer",
		"test:once:public": "vitest run --config vitest.public.config.ts",
		"test:consumer": "node --test __tests__/fixtures/consumer/runtime.ts && tsc -p __tests__/fixtures/consumer/tsconfig.json",
		"cov": "vitest run --config vitest.total-coverage.config.ts --coverage",
		"test:packaging": "node __tests__/packaging.ts",
		"cov:recoverage": "recoverage",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx"
	},
	"dependencies": {
		"motion": "14.6.0"
	},
	"devDependencies": {
		"@atom.io/react": "workspace:*",
		"@testing-library/react": "16.3.3",
		"@tsdown/css": "0.23.2",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "5.0.5",
		"atom.io": "workspace:*",
		"breakage": "0.8.5",
		"eslint": "10.13.0",
		"happy-dom": "21.0.4",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"recoverage": "0.1.20",
		"tsdown": "0.23.2",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"@atom.io/react": "^0.1",
		"@types/react": "^18.0.0 || ^19.0.0",
		"atom.io": "^0.53.3 || ^0.54.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
