---
import { collect, serialize } from "./server.js"

const { value, payload } = await collect(() => Astro.slots.render("default"), {
	signal: Astro.request.signal,
})
---
<astro-resumption>
	<Fragment set:html={value} />
	<script
		is:inline
		type="application/json"
		data-resumable
		set:html={serialize(payload)}
	/>
</astro-resumption>
