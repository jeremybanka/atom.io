{
	"name": "@atom.io/template-preact-svg-editor",
	"version": "0.1.4",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/preact-svg-editor"
	},
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		"./contour": "./src/svg-contour.ts",
		"./convergence": "./src/svg-convergence.ts",
		"./domain": "./src/svg-domain.ts",
		"./model": "./src/svg-editor-state.ts"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:types",
		"lint:eslint": "eslint --max-warnings 0 .",
		"lint:oxlint": "oxlint --deny-warnings .",
		"lint:types": "tsc -b",
		"preview": "vite preview",
		"test": "vitest run",
		"test:once": "vitest run"
	},
	"dependencies": {
		"@atom.io/react": "workspace:*",
		"@atom.io/realtime": "workspace:*",
		"atom.io": "workspace:*",
		"preact": "11.1.1",
		"react": "npm:@preact/compat@18.3.2",
		"react-dom": "npm:@preact/compat@18.3.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@atom.io/eslint-plugin": "workspace:*",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.28.2",
		"@dprint/oxc": "0.48.0",
		"@preact/preset-vite": "2.10.6",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"dprint": "0.64.3",
		"dprint-plugin-malva": "0.16.0",
		"eslint": "10.14.0",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
