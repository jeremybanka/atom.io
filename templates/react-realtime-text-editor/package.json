{
	"name": "@atom.io/template-react-realtime-text-editor",
	"version": "0.0.4",
	"description": "A realtime text editor built with atom.io, React, and Lasertag.",
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/react-realtime-text-editor"
	},
	"type": "module",
	"engines": {
		"node": ">=24.12.0"
	},
	"scripts": {
		"dev": "concurrently vite \"node --watch node/server.ts\"",
		"build": "tsc -b && vite build",
		"lint": "npm run lint:eslint && npm run lint:lasertag && npm run lint:types",
		"lint:eslint": "eslint .",
		"lint:lasertag": "lasertag check \"src/**/*.module.css\"",
		"lint:types": "tsc -b",
		"preview": "concurrently \"vite preview\" \"node node/server.ts\"",
		"test": "vitest run",
		"test:once": "vitest run"
	},
	"dependencies": {
		"atom.io": "workspace:*",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"socket.io": "4.8.3",
		"socket.io-client": "4.8.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@typescript-eslint/parser": "8.68.0",
		"@vitejs/plugin-react": "6.1.0",
		"concurrently": "10.0.5",
		"eslint": "10.9.1",
		"happy-dom": "20.11.12",
		"lasertag": "0.7.0",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	}
}
