{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"**/*"
	],
	"exclude": [
		"dist"
	],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@atom.io/water",
		"paths": {
			"c/*": [
				"./src/components/*"
			]
		},
		"types": [
			"lasertag/css-modules"
		]
	}
}
