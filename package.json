{
	"name": "@atom.io/monorepo",
	"version": "0.0.0",
	"private": true,
	"repository": "https://github.com/jeremybanka/atom.io",
	"license": "MPL-2.0",
	"author": "jeremybanka",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"templates/*"
	],
	"scripts": {
		"build": "dotenvx run -- turbo run build",
		"tonnage": "pnpm readme:write",
		"tonnage:check": "pnpm readme:check",
		"cov:public": "dotenvx run -- turbo run cov:public --filter=./packages/*",
		"dev": "dotenvx run -- turbo run dev",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"hooks:install": "mise x -- hk install --mise",
		"lint": "dotenvx run -- turbo run lint",
		"lint:correctly": "correctly check --offline",
		"lint:deps": "pin-checker --ignore-workspaces",
		"lint:eslint": "dotenvx run -- turbo run lint:eslint",
		"lint:fix:eslint": "eslint --fix .",
		"lint:lasertag": "pnpm exec turbo run build --filter=@atom.io/realtime... && lasertag check",
		"lint:oxlint": "dotenvx run -- turbo run lint:oxlint",
		"lint:types": "dotenvx run -- turbo run lint:types",
		"manifest:test": "dotenvx run -- turbo run manifest:test",
		"changes": "changeset",
		"changes:publish": "pnpm run build && changeset publish",
		"changes:version": "pnpm --config.verifyDepsBeforeRun=false exec changeset version",
		"test": "bun run test:corpus-tooling && CI=true dotenvx run -- turbo run test:once --concurrency=2",
		"test:corpus-tooling": "turbo run build --filter=@atom.io/realtime... && bun test scripts/large-document-corpus.test.ts",
		"test:large-document": "turbo run build --filter=@atom.io/realtime... && bun scripts/large-document-corpus.bun.ts test",
		"corpus:large:prepare": "bun scripts/large-document-corpus.bun.ts prepare",
		"corpus:large:verify": "bun scripts/large-document-corpus.bun.ts verify",
		"corpus:large:derive": "bun scripts/large-document-corpus.bun.ts derive",
		"test:breakage": "CI=true dotenvx run -- turbo run test:breakage",
		"test:breakage:peers": "turbo run test:breakage:peers --continue=always --filter=@atom.io/react --filter=@atom.io/solid --filter=@atom.io/react-devtools --filter=@atom.io/eslint-plugin",
		"test:stress:realtime-ipc": "dotenvx run -- turbo run test:stress:realtime-ipc --filter=@atom.io/realtime",
		"vigilance": "bun scripts/vigilance-bot.bun.ts",
		"workflows": "node scripts/update-workflows.node.ts",
		"test:packaging": "turbo run test:packaging --filter=atom.io --filter=@atom.io/react-devtools --filter=@atom.io/realtime",
		"cov": "dotenvx run -- turbo run cov --filter=./packages/*",
		"cov:recoverage": "pnpm cov && dotenvx run -- turbo run cov:recoverage --concurrency=1 --continue=always --filter=./packages/*",
		"readme:write": "dotenvx run -- turbo run readme:write --filter=./packages/*",
		"readme:check": "dotenvx run -- turbo run readme:check --filter=./packages/*",
		"readme:types": "tsc -p scripts/readme/tsconfig.json"
	},
	"devDependencies": {
		"@atom.io/eslint-plugin": "workspace:*",
		"@atom.io/react": "workspace:*",
		"@atom.io/react-devtools": "workspace:*",
		"@atom.io/realtime": "workspace:*",
		"@atom.io/solid": "workspace:*",
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@correctlyjs/schemars": "0.0.6",
		"@dotenvx/dotenvx": "2.38.2",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.28.2",
		"@dprint/oxc": "0.48.0",
		"@dprint/toml": "0.9.0",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.5",
		"@types/semver": "7.8.0",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"@typescript-eslint/utils": "8.72.1",
		"astro-eslint-parser": "3.2.0",
		"atom.io": "workspace:*",
		"correctly": "0.3.3",
		"dprint": "0.64.3",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.6",
		"dprint-plugin-mdx": "0.1.0",
		"dprint-plugin-yaml": "0.6.0",
		"eslint": "10.13.0",
		"eslint-plugin-astro": "3.2.1",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-storybook": "10.6.5",
		"galley.md": "0.3.1",
		"happy-dom": "21.0.4",
		"jiti": "2.7.0",
		"lasertag": "0.8.10",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"pin-dependencies-checker": "2.7.1",
		"semver": "7.8.5",
		"tonnage": "0.5.1",
		"turbo": "2.11.10",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "26.12.1"
	}
}
