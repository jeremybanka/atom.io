{
	"name": "@atom.io/template-spa-astro-ssr",
	"version": "0.0.1",
	"description": "Astro, SPA, and resumable atom defaults with SQLite server data.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/spa-astro-ssr"
	},
	"license": "MPL-2.0",
	"type": "module",
	"files": [
		"src",
		"tests",
		"exhibits",
		"astro.config.ts",
		"tsconfig.json",
		"README.mdx",
		"_gitignore",
		"scripts",
		"schema.sql",
		".reylo.yaml"
	],
	"scripts": {
		"dev": "npm run db:seed && astro dev",
		"build": "npm run db:seed && tsc --noEmit --runExternalCode && astro build",
		"preview": "astro preview",
		"lint:types": "npm run db:seed && tsc --noEmit --runExternalCode",
		"lint:oxlint": "oxlint src tests astro.config.ts",
		"test": "npm run test:browser",
		"test:browser": "npm run build && node tests/browser.mjs && node tests/browser.mjs --dev",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx",
		"db:seed": "node scripts/seed.ts"
	},
	"dependencies": {
		"@astrojs/node": "11.1.9",
		"@atom.io/spa": "workspace:*",
		"@trpc/client": "11.22.1",
		"@trpc/server": "11.22.1",
		"astro": "7.4.4",
		"atom.io": "workspace:*",
		"resumability": "workspace:*",
		"reylo": "0.6.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@reylosql/sqlite": "0.6.0",
		"@types/node": "26.6.6",
		"galley.md": "0.3.1",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"playwright": "1.64.1",
		"typescript": "7.1.0-dev.20261030.1",
		"vite": "8.3.5"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
