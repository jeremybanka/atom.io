{
	"compilerOptions": {
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"target": "ES2024",
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hydrogen",
		"skipLibCheck": false,
		"noEmit": true,
		"types": [
			"node"
		],
		"lib": [
			"DOM",
			"ESNext"
		]
	},
	"include": [
		"types.ts",
		"loadable-types.ts",
		"jsx-types.tsx"
	]
}
