{
	"name": "@atom.io/template-react-realtime-text-editor",
	"version": "0.0.5",
	"description": "A realtime text editor built with atom.io, React, and Lasertag.",
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/react-realtime-text-editor"
	},
	"type": "module",
	"engines": {
		"node": ">=24.12.0"
	},
	"scripts": {
		"dev": "concurrently vite \"node --watch node/server.ts\"",
		"build": "tsc -b && vite build",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:lasertag && npm run lint:types",
		"lint:eslint": "eslint --max-warnings 0 .",
		"lint:lasertag": "lasertag check \"src/**/*.module.css\"",
		"lint:oxlint": "oxlint --deny-warnings .",
		"lint:types": "tsc -b",
		"preview": "concurrently \"vite preview\" \"node node/server.ts\"",
		"test": "vitest run",
		"test:browser": "playwright test",
		"test:once": "vitest run"
	},
	"dependencies": {
		"@lexical/react": "0.49.0",
		"@lexical/selection": "0.49.0",
		"atom.io": "workspace:*",
		"lexical": "0.49.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"socket.io": "4.8.3",
		"socket.io-client": "4.8.3",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@dprint/json": "0.23.0",
		"@dprint/markdown": "0.23.2",
		"@dprint/oxc": "0.37.0",
		"@playwright/test": "1.62.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@typescript-eslint/parser": "8.69.0",
		"@vitejs/plugin-react": "6.1.1",
		"concurrently": "10.0.5",
		"dprint": "0.57.0",
		"dprint-plugin-malva": "0.16.0",
		"eslint": "10.9.1",
		"happy-dom": "20.12.0",
		"lasertag": "0.8.0",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	}
}
