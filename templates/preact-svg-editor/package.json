		"preview": "vite preview"
	},
	"dependencies": {
		"@atom.io/react": "workspace:*",
		"atom.io": "workspace:*",
		"preact": "11.0.1",
		"react": "npm:@preact/compat@18.3.2",
		"react-dom": "npm:@preact/compat@18.3.2"
	},
	"devDependencies": {
		"@atom.io/eslint-plugin": "workspace:*",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.27.0",
		"@dprint/oxc": "0.47.0",
		"@preact/preset-vite": "2.10.6",
		"@typescript-eslint/eslint-plugin": "8.72.0",
		"@typescript-eslint/parser": "8.72.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"dprint": "0.64.1",
		"dprint-plugin-malva": "0.16.0",
		"eslint": "10.13.0",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "8.3.4"
	},
	"publishConfig": {
		"access": "public"
	}
