{
	"name": "@atom.io/template-preact-realtime-vector-editor",
	"version": "0.1.14",
	"description": "A realtime collaborative vector editor built with Atom.io Mosaic Domains and Preact.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/preact-realtime-vector-editor"
	},
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently vite \"node --watch node/server.ts\"",
		"build": "tsc -b && vite build",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:lasertag && npm run lint:types",
		"lint:eslint": "eslint --max-warnings 0 .",
		"lint:lasertag": "lasertag check \"src/**/*.module.css\"",
		"lint:oxlint": "oxlint --deny-warnings .",
		"lint:types": "tsc -b",
		"preview": "concurrently \"vite preview\" \"node node/server.ts\"",
		"test": "vitest run",
		"test:once": "vitest run"
	},
	"dependencies": {
		"@atom.io/react": "workspace:*",
		"@atom.io/realtime": "workspace:*",
		"@atom.io/template-preact-svg-editor": "workspace:*",
		"atom.io": "workspace:*",
		"preact": "11.2.0",
		"socket.io": "4.8.4",
		"socket.io-client": "4.8.4"
	},
	"devDependencies": {
		"@atom.io/eslint-plugin": "workspace:*",
		"@dprint/json": "0.26.0",
		"@dprint/markdown": "0.29.0",
		"@dprint/oxc": "0.52.0",
		"@preact/preset-vite": "2.10.6",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.11",
		"@types/react": "19.3.3",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/parser": "8.74.0",
		"concurrently": "10.0.7",
		"dprint": "0.65.0",
		"dprint-plugin-malva": "0.16.1",
		"eslint": "10.15.0",
		"happy-dom": "21.0.4",
		"lasertag": "0.9.1",
		"oxlint": "1.95.0",
		"oxlint-tsgolint": "7.0.2008",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-compiler": "npm:typescript@7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.2"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
