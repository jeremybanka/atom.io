{
	"compilerOptions": {
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"target": "ES2024",
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@atom.io/spa",
		"skipLibCheck": false,
		"noEmit": true,
		"types": [],
		"lib": ["DOM", "ESNext"]
	},
	"include": ["types.tsx"]
}
