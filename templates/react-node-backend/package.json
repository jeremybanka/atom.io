{
	"name": "@atom.io/template-react-node-backend",
	"version": "0.0.96",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/react-node-backend"
	},
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently vite ./node/server.ts ./node/authenticator.ts",
		"build": "vite build",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:types",
		"lint:eslint": "eslint --max-warnings 0 .",
		"lint:oxlint": "oxlint --deny-warnings .",
		"lint:types": "tsc -b",
		"preview": "concurrently \"vite preview\" ./node/server.ts ./node/authenticator.ts"
	},
	"dependencies": {
		"atom.io": "workspace:*",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@dprint/json": "0.24.0",
		"@dprint/markdown": "0.24.0",
		"@dprint/oxc": "0.40.0",
		"@eslint-react/eslint-plugin": "5.19.1",
		"@types/node": "26.6.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"babel-plugin-react-compiler": "1.0.0",
		"concurrently": "10.0.5",
		"dprint": "0.57.4",
		"dprint-plugin-malva": "0.16.0",
		"eslint": "10.10.0",
		"eslint-plugin-react-refresh": "0.5.7",
		"globals": "17.12.0",
		"oxc-transform-react": "0.150.0",
		"oxlint": "1.83.0",
		"oxlint-tsgolint": "7.0.2002",
		"typescript": "7.0.2",
		"typescript-eslint": "8.70.0",
		"vite": "8.3.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
