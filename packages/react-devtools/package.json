{
	"name": "@atom.io/react-devtools",
	"version": "0.0.0",
	"description": "React developer tools for atom.io stores.",
	"homepage": "https://atom.io.fyi/docs/react-devtools",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/react-devtools"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./css": {
			"types": "./css.d.ts",
			"import": "./dist/style.css"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"css.d.ts"
	],
	"scripts": {
		"build": "tsdown",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check"
	},
	"dependencies": {
		"motion": "14.4.0"
	},
	"devDependencies": {
		"@atom.io/react": "workspace:*",
		"@tsdown/css": "0.23.1",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"atom.io": "workspace:*",
		"breakage": "0.8.5",
		"eslint": "10.13.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tsdown": "0.23.1",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@atom.io/react": "~0.0.0",
		"@types/react": "^18.0.0 || ^19.0.0",
		"atom.io": "^0.53.3 || ^0.54.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
