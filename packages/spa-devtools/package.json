{
	"name": "@atom.io/spa-devtools",
	"version": "0.0.8",
	"description": "Atom.io's debugger, rendered with spa.",
	"homepage": "https://github.com/jeremybanka/atom.io/tree/main/packages/spa-devtools#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/spa-devtools"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": [
		"**/*.css"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./css": {
			"types": "./dist/css.d.ts",
			"default": "./dist/devtools.css"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check",
		"test": "vitest",
		"test:once": "vitest run --config vitest.config.ts && pnpm test:consumer",
		"test:consumer": "node __tests__/fixtures/consumer/check.ts && node __tests__/fixtures/react-consumer/check.ts",
		"test:packaging": "node __tests__/packaging.ts",
		"cov": "vitest run --config vitest.config.ts --coverage",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx",
		"tonnage": "pnpm readme:write",
		"tonnage:check": "pnpm readme:check",
		"test:browser": "node __tests__/window-browser.mjs && node __tests__/ecology-browser.mjs"
	},
	"devDependencies": {
		"@atom.io/react": "workspace:*",
		"@atom.io/spa": "workspace:*",
		"@breakage/changesets": "0.1.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "5.1.0",
		"atom.io": "workspace:*",
		"breakage": "0.10.2",
		"esbuild": "0.28.2",
		"eslint": "10.14.0",
		"happy-dom": "21.0.4",
		"playwright": "1.65.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tsdown": "0.23.7",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"@atom.io/react": "^0.2.1",
		"@atom.io/spa": ">=0.0.5 <0.1.0",
		"@types/react": "^18.0.0 || ^19.0.0",
		"atom.io": "^0.54.1",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"@atom.io/react": {
			"optional": true
		},
		"@types/react": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
