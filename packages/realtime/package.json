{
	"name": "@atom.io/realtime",
	"version": "0.1.0",
	"description": "Realtime collaboration, clients, servers, and testing for atom.io.",
	"homepage": "https://atom.io.fyi/docs/realtime",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "packages/realtime"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"import": "./dist/client/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js"
		},
		"./react/lexical": {
			"types": "./dist/react/lexical/index.d.ts",
			"import": "./dist/react/lexical/index.js"
		},
		"./testing/headless": {
			"types": "./dist/testing/headless/index.d.ts",
			"import": "./dist/testing/headless/index.js"
		},
		"./testing/react": {
			"types": "./dist/testing/react/index.d.ts",
			"import": "./dist/testing/react/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/core/index.js",
	"types": "./dist/core/index.d.ts",
	"files": [
		"dist",
		"src",
		"docs",
		"AGENTS.md"
	],
	"scripts": {
		"build": "tsdown",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc && tsc -p tsconfig.exhibits.json",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test": "vitest",
		"test:once": "vitest run --config vitest.dist.config.ts",
		"test:once:public": "vitest run --config vitest.public.config.ts",
		"cov": "vitest run --config vitest.total-coverage.config.ts --coverage",
		"cov:recoverage": "recoverage",
		"test:stress:realtime-ipc": "ATOM_IO_TEST_ROOM_STARTUP_DELAY_MS=1250 vitest run --config vitest.dist.config.ts __tests__/private/experiments/realtime-ipc/game-servers.test.tsx",
		"test:packaging": "node __scripts__/test-packaging.ts",
		"readme:write": "galley write README.mdx",
		"readme:check": "galley check README.mdx"
	},
	"devDependencies": {
		"@atom.io/react": "workspace:*",
		"@atom.io/solid": "workspace:*",
		"@lexical/react": "0.52.0",
		"@lexical/selection": "0.52.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "5.0.5",
		"arktype": "2.2.9",
		"atom.io": "workspace:*",
		"eslint": "10.13.0",
		"happy-dom": "21.0.4",
		"lexical": "0.52.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"recoverage": "0.1.20",
		"socket.io": "4.8.4",
		"socket.io-client": "4.8.4",
		"solid-js": "1.9.17",
		"tsdown": "0.23.3",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"@atom.io/react": "^0.1",
		"@lexical/react": ">=0.49.0",
		"@lexical/selection": ">=0.49.0",
		"@testing-library/react": ">=14.0.0",
		"@types/react": "^18.0.0 || ^19.0.0",
		"atom.io": "^0.54.0",
		"happy-dom": ">=17.4.4",
		"lexical": ">=0.49.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"socket.io": ">=4.0.0",
		"socket.io-client": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"@atom.io/react": {
			"optional": true
		},
		"@lexical/react": {
			"optional": true
		},
		"@lexical/selection": {
			"optional": true
		},
		"@testing-library/react": {
			"optional": true
		},
		"@types/react": {
			"optional": true
		},
		"happy-dom": {
			"optional": true
		},
		"lexical": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"socket.io": {
			"optional": true
		},
		"socket.io-client": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"agentDocs": "./AGENTS.md"
}
