{
	"name": "tonnage",
	"version": "0.0.0",
	"description": "Keep deterministic bundle size reports in README files and CI.",
	"type": "module",
	"license": "MIT",
	"author": "Jeremy Banka",
	"engines": {
		"node": ">=22.18.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/tonnage.git"
	},
	"files": [
		"bin",
		"dist",
		"src",
		"examples",
		"README.md"
	],
	"bin": {
		"tonnage": "bin/tonnage.bin.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"lint:eslint": "eslint",
		"lint:oxlint": "oxlint",
		"lint:types": "tsc",
		"test:once": "vitest run"
	},
	"dependencies": {
		"esbuild": "0.28.1"
	},
	"devDependencies": {
		"@types/node": "26.4.0",
		"eslint": "10.9.1",
		"tsdown": "0.22.14",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
