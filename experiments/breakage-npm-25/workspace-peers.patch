+function workspaceDirectory(
+	config: NpmConfig,
+	directory: string,
+	peer: string,
+): string {
+	const local = config.localPeers?.[peer]
+	if (!local)
+		throw new Error(`Workspace peer ${peer} needs a localPeers directory.`)
+	return path.resolve(directory, local.directory)
+}
+
+export async function currentManifest(
+	config: NpmConfig,
+	directory: string,
+): Promise<Manifest> {
+	return await resolveWorkspacePeers(
+		await readManifest(path.join(directory, `package.json`)),
+		async (peer) => {
+			const local = await readManifest(
+				path.join(workspaceDirectory(config, directory, peer), `package.json`),
+			)
+			if (local.name !== peer)
+				throw new Error(`Workspace peer identity mismatch for ${peer}.`)
+			return local.version
+		},
+	)
+}
