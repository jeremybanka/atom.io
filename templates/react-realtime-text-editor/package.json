{
	"name": "@atom.io/template-react-realtime-text-editor",
	"version": "0.0.25",
	"description": "A realtime text editor built with atom.io, React, and Lasertag.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/react-realtime-text-editor"
	},
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently vite \"node --watch node/server.ts\"",
		"build": "tsc -b && vite build",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:lasertag && npm run lint:types",
		"lint:eslint": "eslint --max-warnings 0 .",
		"lint:lasertag": "lasertag check \"src/**/*.module.css\"",
		"lint:oxlint": "oxlint --deny-warnings .",
		"lint:types": "tsc -b",
		"preview": "concurrently \"vite preview\" \"node node/server.ts\"",
		"test": "vitest run",
		"test:browser": "playwright test",
		"test:once": "vitest run",
		"test:browser:install": "playwright install --only-shell chromium"
	},
	"dependencies": {
		"@atom.io/react": "workspace:*",
		"@atom.io/realtime": "workspace:*",
		"@lexical/react": "0.53.0",
		"@lexical/selection": "0.53.0",
		"atom.io": "workspace:*",
		"lexical": "0.53.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"socket.io": "4.8.4",
		"socket.io-client": "4.8.4",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@atom.io/eslint-plugin": "workspace:*",
		"@dprint/json": "0.26.0",
		"@dprint/markdown": "0.29.0",
		"@dprint/oxc": "0.51.0",
		"@playwright/test": "1.65.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/parser": "8.73.0",
		"@vitejs/plugin-react": "6.3.0",
		"concurrently": "10.0.7",
		"dprint": "0.65.0",
		"dprint-plugin-malva": "0.16.1",
		"eslint": "10.15.0",
		"happy-dom": "21.0.4",
		"lasertag": "0.9.1",
		"oxlint": "1.95.0",
		"oxlint-tsgolint": "7.0.2008",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-compiler": "npm:typescript@7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
