{
	"name": "@atom.io/template-react-node-backend",
	"version": "0.0.97",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/atom.io.git",
		"directory": "templates/react-node-backend"
	},
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently vite ./node/server.ts ./node/authenticator.ts",
		"build": "vite build",
		"fmt": "dprint fmt .",
		"fmt:check": "dprint check .",
		"lint": "npm run lint:eslint && npm run lint:oxlint && npm run lint:types",
		"lint:eslint": "eslint --max-warnings 0 .",
		"lint:oxlint": "oxlint --deny-warnings .",
		"lint:types": "tsc -b",
		"preview": "concurrently \"vite preview\" ./node/server.ts ./node/authenticator.ts"
	},
	"dependencies": {
		"atom.io": "workspace:*",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.26.0",
		"@dprint/oxc": "0.44.0",
		"@eslint-react/eslint-plugin": "5.24.6",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"babel-plugin-react-compiler": "1.0.0",
		"concurrently": "10.0.5",
		"dprint": "0.60.1",
		"dprint-plugin-malva": "0.16.0",
		"eslint": "10.12.0",
		"eslint-plugin-react-refresh": "0.5.7",
		"globals": "17.13.0",
		"oxc-transform-react": "0.153.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"typescript": "7.0.2",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
